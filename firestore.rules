rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 사용자 문서 규칙
    match /users/{userId} {
      // 사용자는 자신의 문서만 읽기/쓰기 가능
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // 사용자의 히스토리 서브컬렉션 규칙
      match /history/{historyId} {
        // 사용자는 자신의 히스토리만 읽기/쓰기 가능
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}